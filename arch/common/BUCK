load("//:zephyr_rules.bzl", "zephyr_library")
load("//boards:all.bzl", "BOARD_NAME_SELECT", "ISR_TABLES_BOARD_NAME_SELECT", "driver_src_select")

# init.c is universal; arch-specific extras (sw_isr_common, xip, multilevel_irq)
# are declared per board in driver_srcs["arch_common_srcs"].
zephyr_library(
    name = "arch_common",
    board = BOARD_NAME_SELECT,
    srcs = ["init.c"] + driver_src_select("arch_common_srcs"),
    supervisor = True,
    visibility = ["PUBLIC"],
)

# Placeholder isr_tables.a — the real ISR table .o is produced by
# gen_isr_tables.py at link time (zephyr_postprocess) and injected via
# extra_archives.  This stub satisfies the linker's undefined-symbol ref
# during the pre0 pass.  Only ARM Cortex-M and RISC-V use this mechanism.
zephyr_library(
    name = "isr_tables",
    board = ISR_TABLES_BOARD_NAME_SELECT,
    srcs = ["isr_tables.c"],
    supervisor = True,
    visibility = ["PUBLIC"],
)
