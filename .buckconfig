[cells]
  root = .

[buildfile]
  name = BUCK

[project]
  ignore = .git, twister-out*, .west

[parser]
  target_platform_detector_spec = target:root//...->//boards/qemu/x86:qemu_x86

[zephyr]
  root      = .
  sdk       = ../../zephyr-sdk-1.0.1
  hal_cmsis = ../modules/hal/cmsis_6
  python    = ../env/bin/python
